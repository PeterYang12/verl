+"""Group-wise FP8 fake quantization backend for ModelOpt.
+
+Reproduces how an FP8 inference engine quantizes activations for a block-scaled
+W8A8 GEMM: one E4M3 scale per 128 values along the reduction axis, recomputed
+every forward, stored as float32. On ROCm that is ``aiter``'s ``per_1x128``.
+
+ModelOpt can express per-group dynamic blocking, but routes it through
+``modelopt_cuda_ext_mx``, which is CUDA-only, so this provides an equivalent
+pure-PyTorch path.
+
+``e8m0_scale`` rounds the scale up to a power of two. Leave it off unless the
+target engine does the same -- vLLM only does on the DeepGEMM path, which needs
+Hopper/Blackwell, so on ROCm the scales stay plain float32.
+"""
+
+import logging
+
+import torch
+import torch.nn.functional as F
+
+logger = logging.getLogger(__name__)
+
+BACKEND_NAME = "verl_fp8_group"
+
+_FP8_E4M3_MAX = 448.0
+
+
+def fp8_group_fake_quant(inputs: torch.Tensor, quantizer) -> torch.Tensor:
+    """Fake-quantize ``inputs`` to E4M3 with one scale per group along the last axis.
+
+    ``quantizer.backend_extra_args`` accepts:
+        group_size (int): values per scale, default 128.
+        e8m0_scale (bool): round scales up to a power of two, default False.
+    """
+    extra = getattr(quantizer, "backend_extra_args", None) or {}
+    group_size = int(extra.get("group_size", 128))
+    e8m0_scale = bool(extra.get("e8m0_scale", False))
+
+    orig_dtype = inputs.dtype
+    last = inputs.shape[-1]
+    pad = (-last) % group_size
+    padded = F.pad(inputs, (0, pad)) if pad else inputs
+
+    grouped = padded.float().reshape(*padded.shape[:-1], padded.shape[-1] // group_size, group_size)
+    amax = grouped.abs().amax(dim=-1, keepdim=True)
+    # An all-zero group would otherwise divide by zero; its values quantize to 0
+    # either way.
+    scale = (amax / _FP8_E4M3_MAX).clamp(min=torch.finfo(torch.float32).tiny)
+    if e8m0_scale:
+        scale = torch.exp2(torch.ceil(torch.log2(scale)))
+
+    quantized = (grouped / scale).clamp(-_FP8_E4M3_MAX, _FP8_E4M3_MAX).to(torch.float8_e4m3fn).float() * scale
+    quantized = quantized.reshape(*padded.shape)
+    if pad:
+        quantized = quantized[..., :last]
+    quantized = quantized.to(orig_dtype)
+
+    # Straight-through estimator: the rounding is not differentiable, so the
+    # gradient passes to the unquantized input unchanged.
+    return inputs + (quantized - inputs).detach()
+
+
+def register() -> bool:
+    """Register the backend with ModelOpt. Returns whether it is available."""
+    try:
+        from modelopt.torch.quantization.nn.modules.tensor_quantizer import (
+            is_registered_quant_backend,
+            register_quant_backend,
+        )
+    except ImportError:
+        logger.info("ModelOpt quant backend registry unavailable; skipping %s", BACKEND_NAME)
+        return False
+
+    if not is_registered_quant_backend(BACKEND_NAME):
+        register_quant_backend(BACKEND_NAME, fp8_group_fake_quant)
+    return True
